# Application environment
APP_ENV=dev

# PostgreSQL connection string (Supabase / any Postgres)
DB_URI=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_PASS=

# Session signing & verification token secret (use a long random string)
SECRET_KEY=change_me_to_a_long_random_string

# Session max age / email token expiry in seconds
MAX_AGE=300

# Email verification (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Study Guide LLM <onboarding@resend.dev>
MAIL_SALT=change_me_to_a_random_salt

# Frontend / backend URLs
FRONTEND_URI=http://localhost:5173
BACKEND_URI=http://localhost:8000

# Default profile image for new users
DEFAULT_IMAGE=default.png

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=study guide llm

# Firecrawl (web search & scraping)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxx

# Ollama LLM model name
MODEL_NAME=gemma4:latest
